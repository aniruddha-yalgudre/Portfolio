import { useContext, useEffect, useRef, useState } from "react"
import LocomotiveScroll from "locomotive-scroll"
import { Navbar, BottomNavbar } from "./Components/Navbar"
import Loader from "./Partials/Loader"
import Hero from "./Components/Hero"
import Contact from "./Components/Contact"
import Works from "./Components/Works"
import About from "./Components/About"
import FAQ from "./Components/FAQ"
import Footer from "./Components/Footer"
import Footer2 from "./Components/Footer2"
import { ThemeContext } from "./utils/themeContext"
import gsap from "gsap"
import PageTransition from "./Partials/PageTransition"
import _ from "lodash" // Import lodash for throttle

function App() {
  const containerRef = useRef(null)
  const locomotiveScrollRef = useRef(null)
  const { isDarkMode } = useContext(ThemeContext);

  const [isMobile, setIsMobile] = useState(typeof window !== "undefined" ? window.innerWidth < 640 : false)
  const [isTransitioning, setIsTransitioning] = useState(false)
  const [activeSection, setActiveSection] = useState("hero")
  const [locomotiveReady, setLocomotiveReady] = useState(false)

  // Enhanced mobile detection with debouncing
  useEffect(() => {
    let timeoutId
    const handleResize = () => {
      clearTimeout(timeoutId)
      timeoutId = setTimeout(() => {
        const newIsMobile = window.innerWidth < 640
        if (newIsMobile !== isMobile) {
          setIsMobile(newIsMobile)
        }
      }, 100)
    }

    window.addEventListener("resize", handleResize, { passive: true })
    return () => {
      clearTimeout(timeoutId)
      window.removeEventListener("resize", handleResize)
    }
  }, [isMobile])

  // Mouse trail effect - Desktop only
  useEffect(() => {
    if (isMobile) return // Skip mouse trail on mobile

    const svg = document.querySelector("svg.trail")
    if (!svg) return
    const path = svg.querySelector("path")
    const points = []

    const resizeVP = () => {
      const ww = window.innerWidth
      const wh = window.innerHeight
      svg.setAttribute("width", ww)
      svg.setAttribute("height", wh)
      svg.setAttribute("viewBox", `0 0 ${ww} ${wh}`)
    }

    const move = (e) => {
      if (!svg || !path) return
      const x = e.clientX
      const y = e.clientY
      points.push({ x, y })
      if (points.length > 8) points.shift()
      const d = `M ${points.map((p) => `${p.x},${p.y}`).join(" L ")}`
      gsap.to(path, {
        attr: { d: d },
        duration: 0.3,
        ease: "power1",
      })
    }

    resizeVP()
    window.addEventListener("mousemove", move, { passive: true })
    window.addEventListener("resize", resizeVP, { passive: true })

    return () => {
      window.removeEventListener("mousemove", move)
      window.removeEventListener("resize", resizeVP)
    }
  }, [isMobile])

  // Locomotive Scroll: Only initialize for desktop
  useEffect(() => {
    // Clean up existing instance
    if (locomotiveScrollRef.current) {
      locomotiveScrollRef.current.destroy()
      locomotiveScrollRef.current = null
      setLocomotiveReady(false)
    }

    // Only initialize LocomotiveScroll for desktop
    if (!isMobile && containerRef.current) {
      const timer = setTimeout(() => {
        try {
          locomotiveScrollRef.current = new LocomotiveScroll({
            el: containerRef.current,
            smooth: true,
            smoothMobile: false,
            lerp: 0.06,
            multiplier: 0.7,
            // direction: "vertical",
            gestureDirection: "vertical",
            touchMultiplier: 2,
            firefoxMultiplier: 50,
            class: "is-revealed",
            initClass: "has-scroll-init",
            getDirection: true,
            getSpeed: true,
            reloadOnContextChange: true,
            tablet: {
              smooth: false,
              direction: "vertical",
              gestureDirection: "vertical",
            },
            smartphone: {
              smooth: false,
              direction: "vertical",
              gestureDirection: "vertical",
            },
          })

          if (locomotiveScrollRef.current) {
            setLocomotiveReady(true)
            console.log("✅ Locomotive Scroll initialized successfully")

            const handleScroll = (args) => {
              requestAnimationFrame(() => {
                const scrollY = args.scroll.y
                const windowHeight = window.innerHeight
                const sections = document.querySelectorAll("section[id]")

                sections.forEach((section) => {
                  const rect = section.getBoundingClientRect()
                  const sectionId = section.id

                  // Special handling for About section with horizontal scroll (Desktop only)
                  // if (sectionId === "about") {
                  //   const sectionTop = rect.top
                  //   const sectionBottom = rect.bottom
                  //   const sectionHeight = rect.height

                  //   if (sectionTop <= windowHeight * 0.8 && sectionBottom >= windowHeight * 0.2) {
                  //     setActiveSection(sectionId)
                  //   }
                  //   else if (sectionTop <= 0 && sectionBottom >= windowHeight * 0.8) {
                  //     setActiveSection(sectionId)
                  //   }
                  //   else if (sectionHeight > windowHeight * 1.5 && sectionTop <= windowHeight && sectionBottom >= 0) {
                  //     setActiveSection(sectionId)
                  //   }
                  // }
                  // Special handling for Works section with horizontal scroll (Desktop only)
                   if (sectionId === "works") {
                    const sectionTop = rect.top
                    const sectionBottom = rect.bottom

                    if (sectionTop <= windowHeight * 0.5 && sectionBottom >= windowHeight * 0.5) {
                      setActiveSection(sectionId)
                    }
                    else if (sectionTop <= 0 && sectionBottom >= windowHeight) {
                      setActiveSection(sectionId)
                    }
                  } else {
                    // Standard detection for regular sections
                    const sectionTop = rect.top + scrollY
                    const sectionHeight = rect.height
                    const sectionCenter = sectionTop + sectionHeight / 2
                    const currentScrollCenter = scrollY + windowHeight / 2

                    if (
                      currentScrollCenter >= sectionTop - 100 &&
                      currentScrollCenter <= sectionTop + sectionHeight + 100
                    ) {
                      setActiveSection(sectionId)
                    }
                  }
                })
              })
            }

            const handleResize = () => {
              clearTimeout(window.resizeTimeout)
              window.resizeTimeout = setTimeout(() => {
                requestAnimationFrame(() => {
                  if (locomotiveScrollRef.current) {
                    locomotiveScrollRef.current.update()
                  }
                  gsap.refresh()
                })
              }, 150)
            }

            const throttledHandleScroll = _.throttle(handleScroll, 100)
            const throttledHandleResize = _.throttle(handleResize, 100)

            locomotiveScrollRef.current.on("scroll", throttledHandleScroll)
            window.addEventListener("resize", throttledHandleResize, { passive: true })

            const cleanup = () => {
              locomotiveScrollRef.current.off("scroll", throttledHandleScroll)
              window.removeEventListener("resize", throttledHandleResize)
              locomotiveScrollRef.current.destroy()
              locomotiveScrollRef.current = null
              setLocomotiveReady(false)
            }

            return cleanup
          } else {
            console.error("❌ Locomotive Scroll initialization failed")
            setLocomotiveReady(false)
          }
        } catch (error) {
          console.error("❌ Locomotive Scroll initialization failed:", error)
          setLocomotiveReady(false)
        }
      }, 200)

      return () => {
        clearTimeout(timer)
        if (locomotiveScrollRef.current) {
          locomotiveScrollRef.current.destroy()
          locomotiveScrollRef.current = null
          setLocomotiveReady(false)
        }
      }
    } else {
      setLocomotiveReady(false)
    }
  }, [isMobile])

  // Enhanced mobile scroll detection for section highlighting
  useEffect(() => {
    // Skip if not mobile
    if (!isMobile) return;
    
    // Mobile-specific scroll handler for better section detection
    const handleMobileScroll = () => {
      requestAnimationFrame(() => {
        const windowHeight = window.innerHeight;
        const scrollY = window.scrollY;
        const sections = document.querySelectorAll("section[id]");
        
        sections.forEach((section) => {
          const rect = section.getBoundingClientRect();
          const sectionId = section.id;
          
          // Special handling for About and Works sections on mobile
          if (sectionId === "about" || sectionId === "works") {
            const sectionTop = rect.top;
            const sectionBottom = rect.bottom;
            
            // More aggressive detection for these sections on mobile
            if (
              (sectionTop <= windowHeight * 0.7 && sectionBottom >= windowHeight * 0.3) || 
              (sectionTop <= 0 && sectionBottom >= windowHeight * 0.5) ||
              (sectionTop <= windowHeight * 0.5 && sectionBottom >= 0)
            ) {
              setActiveSection(sectionId);
            }
          }
        });
      });
    };
    
    // Add scroll listener for mobile
    window.addEventListener("scroll", handleMobileScroll, { passive: true });
    
    // Initial check
    handleMobileScroll();
    
    return () => {
      window.removeEventListener("scroll", handleMobileScroll);
    };
  }, [isMobile]);

  // Intersection Observer for active section tracking
  useEffect(() => {
    const sections = document.querySelectorAll("section[id]")

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const sectionId = entry.target.id
          
          if (isMobile) {
            // Enhanced mobile detection for About and Works sections
            if (sectionId === "about" || sectionId === "works") {
              // Lower threshold for these sections on mobile
              if (entry.isIntersecting && entry.intersectionRatio > 0.1) {
                setActiveSection(sectionId)
              }
            } else {
              // Standard detection for other sections
              if (entry.isIntersecting && entry.intersectionRatio > 0.3) {
                setActiveSection(sectionId)
              }
            }
          } else {
            // Desktop detection with special handling for horizontal scroll sections
            if (sectionId === "about" || sectionId === "works") {
              if (entry.isIntersecting && entry.intersectionRatio > 0.05) {
                setActiveSection(sectionId)
              }
            } else {
              if (entry.isIntersecting && entry.intersectionRatio > 0.3) {
                setActiveSection(sectionId)
              }
            }
          }
        })
      },
      {
        threshold: isMobile ? [0.1, 0.2, 0.3, 0.5] : [0.05, 0.1, 0.3, 0.5, 0.7],
        rootMargin: isMobile ? "-5% 0px -5% 0px" : "-10% 0px -10% 0px",
      },
    )

    sections.forEach((section) => observer.observe(section))

    return () => {
      sections.forEach((section) => observer.unobserve(section))
    }
  }, [isMobile])

  // Handle navigation clicks
  const handleNavClick = (id) => {
    if (isTransitioning) return

    const target = document.getElementById(id)
    if (!target) {
      console.error(`❌ Target section "${id}" not found`)
      return
    }

    console.log(`🎯 Navigating to: ${id}`)
    setIsTransitioning(true)
    setActiveSection(id)

    // Start page transition
    setTimeout(() => {
      // Always allow native scroll (desktop and mobile), but use Locomotive if available
      if (!locomotiveReady || !locomotiveScrollRef.current || isMobile) {
        // Fallback: Use native scroll
        console.log("📱 Using native scroll")
        target.scrollIntoView({ behavior: "smooth", block: "start" })
      } else {
        // Desktop: Use Locomotive Scroll
        console.log("🖥️ Using Locomotive Scroll")
        try {
          locomotiveScrollRef.current.scrollTo(target, {
            duration: 1200,
            easing: [0.25, 0.0, 0.35, 1.0],
            offset: 0,
          })
          console.log("✅ Locomotive scroll executed")
        } catch (error) {
          console.error("❌ Locomotive scroll failed, using fallback:", error)
          target.scrollIntoView({ behavior: "smooth", block: "start" })
        }
      }
      setIsTransitioning(false)
    }, 1000)
  }

  // Only one scrollbar: let the body scroll, don't set overflow/height on the container
  return (
    <div
      ref={containerRef}
      data-scroll-container
      className="w-full"
      style={{
        overflow: isMobile ? "auto" : "hidden",
        height: isMobile ? "auto" : "100%",
        WebkitOverflowScrolling: "touch",
      }}
    >
      <svg
        className="hidden trail top-0 left-0 md:block fixed w-full pointer-events-none transition-all duration-100 z-[998]"
        viewBox="0 0 40 40"
        fill="none"
        stroke="currentColor"
        strokeWidth="1.5px"
      >
        <path d="M 10 10 L 20 20 " />
      </svg>
     
      {/* <Loader/> */}
      <Navbar onNavClick={handleNavClick} activeSection={activeSection} />
      <PageTransition isActive={isTransitioning} />

      {/* Debug info - uncomment for testing */}
      
      {/* {process.env.NODE_ENV === "development" && (
        <div className="fixed top-20 right-4 z-[1000] bg-black text-white p-2 text-xs">
          <div>Mobile: {isMobile ? "Yes" : "No"}</div>
          <div>Active Section: {activeSection}</div>
        </div>
      )} */}


      <section id="hero" data-scroll-section className="min-h-screen w-full">
        <Hero />
      </section>

      <section id="works" data-scroll-section className="min-h-screen w-full">
        <Works />
      </section>

      <section id="about" data-scroll-section className="min-h-screen w-full">
        <About />
      </section>

      <section id="faq" data-scroll-section className="min-h-screen w-full">
        <FAQ />
      </section>

      <section id="connect" data-scroll-section className="min-h-screen w-full">
        <Contact parentContainerRef={containerRef} />
      </section>

      <section data-scroll-section className="relative min-h-screen w-full">
        <Footer2 />
      </section>

      <BottomNavbar />
    </div>
  )
}

export default App